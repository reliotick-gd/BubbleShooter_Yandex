<linker>
  <!-- Наш код: не трогать ничего -->
  <assembly fullname="Assembly-CSharp" preserve="all"/>

  <!-- mscorlib: коллекции, используемые из кода (страховка от High stripping) -->
  <assembly fullname="mscorlib">
    <type fullname="System.Collections.Generic.Dictionary`2" preserve="all"/>
    <type fullname="System.Collections.Generic.HashSet`1"    preserve="all"/>
    <type fullname="System.Collections.Generic.Stack`1"      preserve="all"/>
    <type fullname="System.Collections.Generic.Queue`1"      preserve="all"/>
    <type fullname="System.Collections.Generic.List`1"       preserve="all"/>
  </assembly>

  <!-- Unity core — PlayerPrefs, JsonUtility, Application, Screen и т.д. -->
  <assembly fullname="UnityEngine.CoreModule"         preserve="all"/>
  <assembly fullname="UnityEngine.JSONSerializeModule" preserve="all"/>
  <assembly fullname="UnityEngine.AudioModule"         preserve="all"/>

  <!-- Input System -->
  <assembly fullname="UnityEngine.InputSystem" preserve="all"/>
  <assembly fullname="Unity.InputSystem"        preserve="all"/>

  <!-- uGUI: Canvas/Text/Image/Button/ScrollRect/EventSystem из кода -->
  <assembly fullname="UnityEngine.UIModule"           preserve="all"/>
  <assembly fullname="UnityEngine.UI"                 preserve="all"/>
  <assembly fullname="UnityEngine.TextRenderingModule" preserve="all"/>

  <!-- 2D/Rendering для SpriteRenderer, Sprite, Texture2D -->
  <assembly fullname="UnityEngine.CoreModule">
    <type fullname="UnityEngine.Sprite"         preserve="all"/>
    <type fullname="UnityEngine.Texture2D"      preserve="all"/>
    <type fullname="UnityEngine.SpriteRenderer" preserve="all"/>
  </assembly>

  <!-- TextCore + TMP: DynamicFont создаёт SDF-шрифт из TTF в рантайме через
       нативный FontEngine (вызовы по рефлексии). При Managed Stripping = High
       это надо явно сохранить, иначе динамический шрифт может отвалиться. -->
  <assembly fullname="UnityEngine.TextCoreFontEngineModule" preserve="all"/>
  <assembly fullname="UnityEngine.TextCoreTextEngineModule" preserve="all"/>
  <assembly fullname="Unity.TextMeshPro"                    preserve="all"/>
</linker>
